# MediLens AI - Environment Configuration

# 1. Free Groq API Key (Sign up at https://console.groq.com)
# Used for ultra-fast LLaMA 3.3 70B clinical reasoning & triage
GROQ_API_KEY=

# 2. Free Google Gemini API Key (Sign up at https://aistudio.google.com)
# Used for Gemini 2.0 Flash multimodal image diagnosis & deep clinical synthesis
GEMINI_API_KEY=

# 3. Optional Free Tavily API Key (1,000 free searches/mo at https://tavily.com)
# Used for real-time web research on modern guidelines & queries beyond the 2002 book
TAVILY_API_KEY=

# 4. Security (JWT Authentication)
JWT_SECRET=medilens_dev_secret_key_81a7f53c_secure_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 5. Storage Paths (Defaults to local backend/data)
CHROMA_PERSIST_DIR=./data/chroma_db
SQLITE_DB_URL=sqlite:///./data/medilens.db

# 6. Embedding Model (HuggingFace local model - 100% free, runs on CPU)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# 7. CORS Settings
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# 8. Neon PostgreSQL Database
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
